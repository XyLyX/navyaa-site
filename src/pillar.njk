---
layout: base.njk
eleventyExcludeFromCollections: true
pagination:
  data: pillars
  size: 1
  alias: pillar
permalink: "/{{ pillar | slugify }}/"
title: "{{ pillar }}"
---
{% set posts = collections.postsByPillar[pillar] %}
{% set featured = posts[0] %}

<div class="nvy-cat-intro">
	<div class="nvy-tag" style="color:#6E3035;">{{ pillar }}</div>
	<h1 class="nvy-serif">Essays on {{ pillar }}. {{ pillarSubs[pillar] }}.</h1>
</div>

{% if featured %}
<section class="nvy-featured" style="margin-bottom:64px;">
	<div class="nvy-featured-img" style="flex:1 1 55%;">
		{% if featured.data.image %}<img src="{{ featured.data.image }}" alt="{{ featured.data.title }}">{% endif %}
	</div>
	<div class="nvy-featured-text" style="flex:1 1 45%;">
		<div class="nvy-eyebrow" style="color:#B5A99A;">Featured Story</div>
		<h2 class="nvy-serif">{{ featured.data.title }}</h2>
		<p style="font-size:14px; line-height:1.65; color:#E9DDD5;">{{ featured.data.excerpt }}</p>
		<div class="nvy-sans" style="font-size:12.5px; color:#B5A99A;">{{ featured.date | dateFmt("LLLL d, yyyy") }} &middot; {{ featured.templateContent | readingTime }} min read</div>
		<a href="{{ featured.url }}" class="nvy-sans" style="color:#F7F4EE; font-size:13px; border-bottom:1px solid #F7F4EE; padding-bottom:2px; width:fit-content;">Read the essay &rarr;</a>
	</div>
</section>
{% endif %}

<section class="nvy-section" style="padding-top:0;">
	<div class="nvy-eyebrow">Latest</div>
	<div class="nvy-card-grid">
		{% for p in posts | slice(1, 4) %}
		<a class="nvy-card" href="{{ p.url }}" style="display:flex; flex-direction:column; gap:16px;">
			<div class="nvy-card-img">{% if p.data.image %}<img src="{{ p.data.image }}" alt="{{ p.data.title }}">{% endif %}</div>
			<h3 class="nvy-serif">{{ p.data.title }}</h3>
			<p>{{ p.data.excerpt }}</p>
			<div class="meta">{{ p.date | dateFmt("LLLL d, yyyy") }} &middot; {{ p.templateContent | readingTime }} min read</div>
		</a>
		{% endfor %}
	</div>
</section>

{% if posts.length %}
<section style="background:#E9DDD5; padding:56px; display:flex; flex-direction:column; gap:24px;">
	<div class="nvy-eyebrow">Most Read in {{ pillar }}</div>
	<div style="display:flex; flex-direction:column; max-width:820px;">
		{% for p in posts | slice(0, 5) %}
		<a class="nvy-most-read-row" href="{{ p.url }}" style="border-bottom:1px solid #D8D1C8;">
			<div class="num">{{ loop.index | pad2 }}</div>
			<div class="title">{{ p.data.title }}</div>
		</a>
		{% endfor %}
	</div>
</section>
{% endif %}

{% if posts.length > 5 %}
<section class="nvy-section">
	<div class="nvy-eyebrow">Older Essays</div>
	<div class="nvy-older-grid">
		{% for p in posts | slice(5, 9) %}
		<a href="{{ p.url }}" style="display:flex; flex-direction:column; gap:10px;">
			<div class="thumb">{% if p.data.image %}<img src="{{ p.data.image }}" alt="{{ p.data.title }}">{% endif %}</div>
			<h4 class="nvy-serif">{{ p.data.title }}</h4>
			<div class="nvy-sans" style="font-size:11.5px; color:#77736D;">{{ p.date | dateFmt("LLLL d, yyyy") }}</div>
		</a>
		{% endfor %}
	</div>
</section>
{% endif %}
