---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom" xmlns:media="http://search.yahoo.com/mrss/">
<channel>
<title>Navyaa</title>
<link>https://navyaa.blog/</link>
<atom:link href="https://navyaa.blog/feed.xml" rel="self" type="application/rss+xml" />
<description>The human side of relationships, emotions and becoming yourself.</description>
<language>en</language>
{%- for post in collections.posts %}
{%- set picUrl = "" %}{%- set pic = post.data.pin_image or post.data.image %}
{%- if pic %}{% set picUrl = pic if pic.startsWith("http") else "https://navyaa.blog" + pic %}{% endif %}
<item>
  <title>{{ post.data.title }}</title>
  <link>https://navyaa.blog{{ post.url }}</link>
  <guid>https://navyaa.blog{{ post.url }}</guid>
  <description><![CDATA[{% if picUrl %}<img src="{{ picUrl }}" alt="{{ post.data.title }}" />{% endif %}{{ post.data.excerpt }}]]></description>
  {% if picUrl %}<media:content url="{{ picUrl }}" medium="image" />{% endif %}
  {% if post.date %}<pubDate>{{ post.date.toUTCString() }}</pubDate>{% endif %}
</item>
{%- endfor %}
</channel>
</rss>
